#include "resource.h"
#include "afxres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_MAIN_DIALOG DIALOGEX 0, 0, 400, 260
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "PolyGrep - MFC"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Folder:",IDC_STATIC,7,10,28,8
    EDITTEXT        IDC_EDIT_ROOT,40,7,290,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BTN_BROWSE,336,7,57,14

    LTEXT           "Pattern:",IDC_STATIC,7,29,30,8
    EDITTEXT        IDC_EDIT_PATTERN,40,26,170,14,ES_AUTOHSCROLL
    LTEXT           "Ext:",IDC_STATIC,216,29,16,8
    EDITTEXT        IDC_EDIT_EXT,234,26,96,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Search",IDC_BTN_SEARCH,336,26,57,14

    CONTROL         "Regex",IDC_CHK_REGEX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,40,47,42,10
    CONTROL         "Case sensitive",IDC_CHK_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,86,47,64,10
    LTEXT           "Threads (0=auto):",IDC_STATIC,156,48,58,8
    EDITTEXT        IDC_EDIT_THREADS,216,45,26,14,ES_NUMBER
    LTEXT           "Max (0=all):",IDC_STATIC,248,48,40,8
    EDITTEXT        IDC_EDIT_MAX,290,45,40,14,ES_NUMBER
    PUSHBUTTON      "Cancel",IDC_BTN_CANCEL,336,45,57,14

    CONTROL         "",IDC_LIST_RESULTS,"SysListView32",LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,65,386,172
    LTEXT           "Ready",IDC_STATIC_STATUS,7,243,386,10
END
